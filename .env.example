# SKIL Automation — One-Person AI Creator Studio
# Copy this file to .env and fill in real values when you have API keys.
# The system runs in simulation mode when keys are absent (nothing hits the
# public internet or spends money without explicit approval).

CREATOR_NAME=Maya Cole
BUSINESS_NAME=One-Person AI Creator Studio

# Voice synthesis & dubbing
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_CLONE_ID=maya-cole-clone

# Visuals & editing
HIGGSFIELD_API_KEY=
DESCRIPT_API_KEY=

# Scheduling & distribution
METRICOOL_API_KEY=

# Monetization
STRIPE_API_KEY=
STRIPE_CHECKOUT_BASE_URL=https://buy.stripe.com/
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Analytics
YOUTUBE_API_KEY=

# Human-in-the-loop notification channel (approval pings)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Studio
STUDIO_TZ=Asia/Kolkata
MORNING_BRIEF_HOUR=7